{
  "name": "nthterm",
  "version": "0.1.0-rc.7",
  "description": "A rich desktop terminal workspace manager built with Angular, Electron, xterm.js, node-pty, and SQLite.",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "serve": "ng serve --host 127.0.0.1 --port 4200",
    "electron:dev": "wait-on tcp:4200 && cross-env NTH_TERM_RENDERER_URL=http://127.0.0.1:4200 electron .",
    "dev": "concurrently -k \"npm:serve\" \"npm:electron:dev\"",
    "build": "ng build",
    "desktop": "npm run build && cross-env NODE_ENV=production electron .",
    "electron:rebuild": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --dir --publish never",
    "release": "npm run build && electron-builder --publish never",
    "release:win": "npm run build && electron-builder --win --publish never",
    "release:mac": "npm run build && electron-builder --mac --publish never",
    "smoke:mac": "bash scripts/smoke-macos.sh",
    "rc:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-rc.ps1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:electron": "node --test electron/terminal-spawn-coordinator.spec.js electron/terminal-spawn-env.spec.js electron/terminal-start-registry.spec.js electron/resolve-shell.spec.js electron/wsl-distros.spec.js electron/patch-node-pty-windows.spec.js electron/branding-assets.spec.js electron/release-assets.spec.js electron/macos-smoke.spec.js electron/adaptive-layout.spec.js electron/window-chrome.spec.js electron/workspace-store.spec.js electron/auto-update.spec.js",
    "test:ci": "npm run test:electron && ng test --watch=false",
    "postinstall": "node electron/patch-node-pty-windows.js"
  },
  "private": true,
  "author": "NthTerm contributors",
  "build": {
    "appId": "com.nwaoga.nthterm",
    "productName": "NthTerm",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/nthterm/browser/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nwaoga",
        "repo": "NthTerm"
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@types/node": "^25.9.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.9.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.10"
  }
}
